# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Machine-specific. Never committed: this repo is public.
local.properties

# IDE
.idea/
*.iml
.kotlin/

# macOS
.DS_Store

# Kotlin/Native & JS
kotlin-js-store/
*.klib

# Xcode
xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# Signing material. CD-04: keystores and passwords live in GitHub Actions secrets only.
*.jks
*.keystore
keystore.properties

# demo/ — consumes locally-built artifacts (XCFrameworks, npm tarball dirs), so these are
# always regenerated, never checked in. package-lock.json is excluded too: it would pin
# a `file:` dependency's integrity hash to one specific local Gradle build.
demo/*/node_modules/
demo/*/package-lock.json
demo/ios/.build/
demo/ios/.swiftpm/
demo/web/.local-packages/
demo/web/.next/
.dependency-check-data/
